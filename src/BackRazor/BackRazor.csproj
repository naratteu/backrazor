<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <NoWarn>$(NoWarn);BL0006</NoWarn>
    <Version>0.3.0-preview.1</Version>
    <Description>Razor-owned object lifetimes, serialized configuration transitions, and read-only observation.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>naratteu</Authors>
    <PackageProjectUrl>https://github.com/naratteu/backrazor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/naratteu/backrazor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageTags>razor;blazor;headless;lifecycle;observable</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="R3" Version="1.3.1" />
    <ProjectReference Include="../../BackRazor.Contracts/BackRazor.Contracts.csproj" />
    <ProjectReference Include="../../BackRazor.Analyzers/BackRazor.Analyzers.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="../../BackRazor.Analyzers/bin/$(Configuration)/netstandard2.0/BackRazor.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
